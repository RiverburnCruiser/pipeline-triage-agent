# Copy to .env and adjust. .env is git-ignored; never commit real credentials.
POSTGRES_USER=triage
POSTGRES_PASSWORD=triage
POSTGRES_DB=triage
DATABASE_URL=postgresql://triage:triage@localhost:5432/triage

# Lets pytest run the database tests against the same local container. It must be a
# different database from DATABASE_URL: the tests rebuild the runbook tables. pytest
# creates triage_test on first use.
TRIAGE_TEST_DATABASE_URL=postgresql://triage:triage@localhost:5432/triage_test

# The triage agent (pipeline-triage-agent). Get a key at https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...
# Optional overrides
# TRIAGE_MODEL=claude-opus-5-5
# TRIAGE_EFFORT=medium

# Or run the agent on Gemini's free tier. Get a key at https://aistudio.google.com/apikey
# TRIAGE_PROVIDER=gemini
# GEMINI_API_KEY=your-key
# TRIAGE_MODEL=gemini-3.5-flash       # the default; each model has its own daily quota
