# Copy to .env and adjust. .env is git-ignored; never commit real credentials.
POSTGRES_USER=triage
POSTGRES_PASSWORD=triage
POSTGRES_DB=triage
DATABASE_URL=postgresql://triage:triage@localhost:5432/triage

# Lets pytest run the database tests against the same local container.
TRIAGE_TEST_DATABASE_URL=postgresql://triage:triage@localhost:5432/triage
